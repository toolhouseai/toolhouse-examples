# API Keys Configuration

# Anthropic API Key (required)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Toolhouse API Key (required)
# Get from: https://app.toolhouse.ai/settings/api-keys
TOOLHOUSE_API_KEY=your_toolhouse_api_key_here

# Stripe API Key (required)
# Get from: https://dashboard.stripe.com/apikeys
# Use test key for development: sk_test_...
# Use live key for production: sk_live_...
STRIPE_API_KEY=your_stripe_api_key_here

# Optional: Stripe Webhook Secret (for production)
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
